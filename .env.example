# Every environment variable rackctl reads. None is required for a default install.
#
# The AWS values are the standard SDK surface and are normally supplied by your profile or
# SSO session rather than set here — rackctl reads them, it does not ask you to export them.
# Copy this file to .env only if you prefer them explicit.

# ── AWS identity ────────────────────────────────────────────────────────────
# rackctl composes these itself from cloud.profile and cloud.region in rackctl.yaml, and
# with cloud.assumeRole set it replaces them with the assumed session's credentials for the
# duration of the run. Set them here only to run without a profile.
AWS_PROFILE=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ── GitHub ──────────────────────────────────────────────────────────────────
# Required only when org.gitops.tenantsRepo is set, which arms cluster-bootstrap's GitHub
# provider. That provider authenticates from this variable and nothing else, so without it
# the apply 401s in phase 5 with the VPC and cluster already built. `gh auth login` stores
# the credential in gh's keyring and exports nothing; rackctl honours an exported value and
# otherwise asks gh for the token it already holds. Preflight refuses if neither exists.
GITHUB_TOKEN=

# ── Local checkouts (tests only) ────────────────────────────────────────────
# Read by the test suite, never by the binary. Each opts one test out of its fixture and
# into a real clone of the named repo, so an assertion about that repo's live tree runs on
# a machine that has it and skips on one that does not.
RACKCTL_AGENT_PLATFORM_CHECKOUT=
RACKCTL_EKSFLEET_CHECKOUT=

# ── Installer ───────────────────────────────────────────────────────────────
# Read by scripts/install.sh, not by the binary.
RACKCTL_INSTALL_DIR=/usr/local/bin
RACKCTL_VERSION=latest
